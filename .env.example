# Copy this file to .env for local testing only. NEVER commit a real .env.
# On Render/Railway, set these in the dashboard instead (Environment tab).

# 1 = hosted mode (bind 0.0.0.0, Basic Auth on, Etsy creds from env).
# 0 or unset = local-only mode (localhost, keyring creds, no password).
NI_PUBLIC=1

# Login password for the hosted tool. Any username works; the password
# must match this value. Use a long random password.
NI_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Etsy Open API v3 app credentials (from https://www.etsy.com/developers/apps).
# Same app whose keystring/shared secret are saved in Windows Credential
# Manager on the local PC.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Port the server listens on. Hosts set this themselves; local default 8000.
PORT=8000
